generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

model User {
  id     String  @id @default(uuid())
  name   String
  phone  String  @unique
  email  String? @unique
  avatar String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model OTP {
  phone String @id
  otp   String

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  image       String?
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([slug])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id         String @id @default(uuid())
  categoryId String

  name        String
  slug        String  @unique
  description String?

  sku String @unique

  mrp Decimal @db.Decimal(10, 2)

  price Decimal @db.Decimal(10, 2)

  minimumOrderQuantity Int @default(1)

  stockQuantity Int @default(0)

  // Selling measurement
  unit String
  // Example:
  // piece, box, bag, packet, bottle, kg

  // Optional quantity inside one unit
  quantity Decimal? @db.Decimal(10, 2)
  // Example:
  // 5 (5kg bag)
  // 500 (500 gram packet)
  // 1 (1 litre bottle)

  // Quantity measurement type
  quantityType String?
  // Example:
  // kg, gram, litre, ml

  image String?

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([slug])
  @@index([sku])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  image     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

model Banner {
  id       String  @id @default(uuid())
  title    String
  image    String
  link     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

model Offer {
  id       String  @id @default(uuid())
  title    String
  subtitle String?
  image    String?
  discount String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("offers")
}
