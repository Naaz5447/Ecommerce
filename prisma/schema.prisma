generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id        String   @id @default(uuid())
  shopId    String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  Customer[]
  otps       OTP[]
  sequences  Sequence[]
  users      ShopUser[]
  areas      Area[]
  categories Category[]
  products   Product[]

  @@index([isActive])
  @@map("shops")
}

model User {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  email     String?    @unique
  avatar    String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
  shopUsers ShopUser[]

  @@map("users")
}

model ShopUser {
  id        String       @id @default(uuid())
  shopId    String
  userId    String
  role      ShopUserRole @default(CUSTOMER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_users")
}

model OTP {
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, phone])
  @@index([shopId])
  @@index([phone])
  @@map("otps")
}

model Category {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  slug        String
  image       String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid())
  shopId               String
  categoryId           String
  name                 String
  slug                 String
  description          String?
  sku                  String
  mrp                  Decimal  @db.Decimal(10, 2)
  price                Decimal  @db.Decimal(10, 2)
  minimumOrderQuantity Int      @default(1)
  stockQuantity        Int      @default(0)
  unit                 String
  quantity             Decimal? @db.Decimal(10, 2)
  quantityType         String?
  image                String?
  isFeatured           Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  billItems     BillItem[]
  customerRates CustomerProductRate[]
  orderItems    OrderItem[]
  images        ProductImage[]
  saleItems     SaleItem[]

  @@unique([shopId, slug])
  @@unique([shopId, sku])
  @@index([shopId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  image     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  image     String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

model Offer {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  image     String?
  discount  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("offers")
}

model Customer {
  id                   String                @id @default(uuid())
  customerCode         String                @unique
  name                 String
  mobile               String?
  address              String?
  outstanding          Decimal               @default(0) @db.Decimal(10, 2)
  totalPurchase        Decimal               @default(0) @db.Decimal(10, 2)
  totalSales           Decimal               @default(0) @db.Decimal(10, 2)
  totalReceived        Decimal               @default(0) @db.Decimal(10, 2)
  totalPending         Decimal               @default(0) @db.Decimal(10, 2)
  lastPurchaseDate     DateTime?
  lastPaymentDate      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  areaId               String?
  shopId               String
  userId               String?
  area                 Area?                 @relation(fields: [areaId], references: [id])
  shop                 Shop                  @relation(fields: [shopId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  accounts             Account[]
  bills                Bill[]
  customerProductRates CustomerProductRate[]
  orders               Order[]
  sales                Sale[]
}

model BillingProduct {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @default(0) @db.Decimal(10, 2)
  unit      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("billing_products")
}

model Sale {
  id           String     @id @default(cuid())
  customerId   String
  customerName String
  totalAmount  Decimal    @db.Decimal(10, 2)
  paidAmount   Decimal    @db.Decimal(10, 2)
  balance      Decimal    @db.Decimal(10, 2)
  paymentMode  String?
  date         DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invoice      Invoice?
  items        SaleItem[]
  customer     Customer   @relation(fields: [customerId], references: [id])

  @@map("sales")
}

model Purchase {
  id           String   @id @default(cuid())
  party        String
  product      String
  quantity     Decimal  @db.Decimal(10, 2)
  rate         Decimal  @db.Decimal(10, 2)
  amount       Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("purchases")
}

model Note {
  id        String       @id @default(cuid())
  title     String
  content   String
  category  NoteCategory
  color     BigInt
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("notes")
}

model EmployeeDesignation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model Employee {
  id            String               @id
  name          String
  image         String?
  dob           DateTime?
  holidayDemand String?
  gender        Gender?
  joiningDate   DateTime?
  mobile        String
  aadhar        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  employeeId    String               @unique
  designationId String?
  designation   EmployeeDesignation? @relation(fields: [designationId], references: [id])
  bills         Bill[]
  advances      EmployeeAdvance[]
  attendance    EmployeeAttendance[]
}

model Order {
  id                String      @id @default(uuid())
  customerId        String
  customerName      String
  area              String
  orderDateTime     DateTime
  deliveryDate      DateTime?
  status            OrderStatus @default(PENDING)
  isOrderModified   Boolean     @default(false)
  modificationCount Int         @default(0)
  modifications     Json?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderNumber       Int         @unique @default(autoincrement())
  bill              Bill?
  items             OrderItem[]
  customer          Customer    @relation(fields: [customerId], references: [id])

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Bill {
  id                String           @id @default(uuid())
  orderId           String           @unique
  employeeId        String
  customerId        String
  customerName      String
  area              String
  orderDateTime     DateTime?
  deliveryDate      DateTime?
  billDateTime      DateTime
  totalAmount       Decimal          @db.Decimal(10, 2)
  status            BillStatus       @default(PENDING)
  paymentStatus     PaymentStatus    @default(PENDING)
  paidAmount        Decimal          @default(0) @db.Decimal(10, 2)
  pendingAmount     Decimal          @db.Decimal(10, 2)
  isBillModified    Boolean          @default(false)
  modificationCount Int              @default(0)
  modifications     Json?
  cancelledAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  billAllocations   BillAllocation[]
  items             BillItem[]
  customer          Customer         @relation(fields: [customerId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id])
  payments          PaymentHistory[]

  @@index([customerId])
  @@index([employeeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([billDateTime])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([billId])
  @@map("bill_items")
}

model Bank {
  id            String    @id
  bankName      String
  accountName   String
  accountNumber String
  ifsc          String?
  branch        String?
  upiId         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  expenses      Expense[]

  @@map("banks")
}

model Account {
  id                  String           @id
  customerId          String
  customerName        String
  collectionDate      DateTime
  totalReceivedAmount Decimal          @db.Decimal(10, 2)
  cashAmount          Decimal          @default(0) @db.Decimal(10, 2)
  onlinePayments      Json?
  cheques             Json?
  remarks             String?
  isCancelled         Boolean          @default(false)
  cancelledAt         DateTime?
  bankId              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  bank                Bank?            @relation(fields: [bankId], references: [id])
  customer            Customer         @relation(fields: [customerId], references: [id])
  billAllocations     BillAllocation[]
  paymentHistories    PaymentHistory[]

  @@map("accounts")
}

model BillAllocation {
  id            String  @id @default(cuid())
  accountId     String
  billId        String
  amountApplied Decimal @db.Decimal(10, 2)
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bill          Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([billId])
  @@map("bill_allocations")
}

model PaymentHistory {
  id             String   @id @default(cuid())
  billId         String
  accountId      String?
  customerId     String
  paymentDate    DateTime
  amountApplied  Decimal  @db.Decimal(10, 2)
  cashAmount     Decimal  @default(0) @db.Decimal(10, 2)
  onlinePayments Json?
  cheques        Json?
  notes          String?
  createdAt      DateTime @default(now())
  account        Account? @relation(fields: [accountId], references: [id])
  bill           Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([accountId])
  @@map("payment_history")
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  quantity      Decimal  @db.Decimal(10, 2)
  rate          Decimal  @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(10, 2)
  spendBy       String
  expenseDate   DateTime
  onlinePayment Boolean  @default(false)
  bankId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bank          Bank?    @relation(fields: [bankId], references: [id])

  @@map("expenses")
}

model Invoice {
  id            String   @id
  saleId        String   @unique
  invoiceNumber Int      @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_items")
}

model CustomerProductRate {
  id           String   @id @default(cuid())
  customerId   String
  productId    String
  productName  String
  customerRate Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("customer_product_rates")
}

model EmployeeAttendance {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  present    Boolean
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("employee_attendance")
}

model EmployeeAdvance {
  id         String   @id @default(cuid())
  employeeId String
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime
  remarks    String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_advances")
}

model Sequence {
  id     String
  value  Int    @default(0)
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([id, shopId])
  @@index([shopId])
  @@map("sequences")
}

model Area {
  id        String   @id
  shopId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([shopId, name])
  @@index([shopId])
}

enum ShopUserRole {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  PENDING
  GENERATED
  MODIFIED
  CANCELLED
}

enum BillStatus {
  PENDING
  MODIFIED
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum NoteCategory {
  GENERAL
  PERSONAL
  WORK
  FINANCE
  IDEAS
  REMINDER
  OTHER
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}
